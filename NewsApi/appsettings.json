{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "NewsApi": {
    "BaseUrl": "https://newsapi.org/v2/"
  },
  "WeatherApi": {
    "BaseUrl": "https://api.openweathermap.org/data/2.5/"
  },
  "GNews": {
    "BaseUrl": "https://gnews.io/api/v4/"
  },
  "Jwt": {
    "Issuer": "NewsApi",
    "Audience": "NewsApiClient"
  },
  "FeedOptions": {
    "CachingTime": 2, // minutes to cache feed results
    "FastRequestTime": 100, // milliseconds for a request to be considered fast
    "AverageRequestTime": 200, 
    "SlowRequestTime": 5000,
    "AnomalyCheckInterval": 1, // minutes between anomaly checks
    "AnomalyDetectionWindow": 5, // minutes ago in which to check for anomalies
    "AnomalyThresholdMultiplier": 1.5 // how much slower recent performance must be to trigger an anomaly
  }
}